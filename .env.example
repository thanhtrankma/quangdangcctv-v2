# ---- Supabase (Project Settings → API Keys) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: server-only, NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=media

# "mock" = dùng dữ liệu demo trong .data/db.json (bỏ dòng này để dùng Supabase)
# DATA_SOURCE=mock

# ---- Đăng nhập trang quản trị /admin ----
ADMIN_EMAIL=admin@dolphinhouse.vn
ADMIN_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập (vd: openssl rand -base64 32)
AUTH_SECRET=

# Domain chính thức (dùng cho canonical, sitemap)
NEXT_PUBLIC_SITE_URL=https://dolphinhouse.vn
